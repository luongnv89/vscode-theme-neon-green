# --- VCS / editor / tooling ---
.git/**
.gitignore
.vscode/**
.claude/**
.gstack/**
.github/**
.gitissue/**
.pre-commit-config.yaml
.DS_Store
**/.DS_Store

# --- Source, tests & build scripts (not needed at runtime) ---
scripts/**
tests/**
examples/**
docs/**
assets/**

# --- Dev dependencies & lockfiles ---
node_modules/**
package-lock.json
yarn.lock

# --- Non-VS Code companion ports (terminal emulators & apps) ---
# Ship only the VS Code *-color-theme.json files under themes/.
themes/claude-code/**
themes/firefox/**
themes/ghostty/**
themes/cmux/**
themes/terminal/**
themes/warp/**
themes/**/*.itermcolors

# --- Prior packaged artifacts ---
*.vsix

# --- Markdown docs: ship only the README ---
*.md
!README.md
